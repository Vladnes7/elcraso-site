# В репозиторий попадает только код сайта и фото, которые он использует.
# Заметки, запись звонка, архивы и черновики остаются только на компьютере.
/*
!/.gitignore
!/README.md
!/package.json
!/package-lock.json
!/src/
!/scripts/
!/public/
!/Фото для сайта/
!/Телеграм-канал/
!/Фотографии/

/src/*
!/src/data.mjs
!/src/pages.mjs
!/src/site.css
!/src/site.js
/scripts/build-previews.mjs
/public/*
!/public/fonts/
/public/fonts/*.ttf
/Телеграм-канал/*
!/Телеграм-канал/Фото/
/Телеграм-канал/Фото/*.mp4
/Фотографии/*
!/Фотографии/Услуги ногтей/
/Фотографии/Услуги ногтей/*
!/Фотографии/Услуги ногтей/el-craso-41.jpg
/Фото для сайта/*.md
/Фото для сайта/*.txt
.DS_Store
